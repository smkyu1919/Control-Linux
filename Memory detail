############################################################################################
# Memory Detail
############################################################################################
cat /proc/meminfo | egrep 'MemTotal|MemFree|MemAvailable|Buffers|Cached|SReclaimable|SUnreclaim|SwapTotal|SwapFree|Committed_AS|CommitLimit|Huge'
--------------------------------------------------------------------------------------------

| 항목              | 의미                           
| ----------------- | -----------------------------------
| `MemAvailable`    | 실제 추가로 쓸 수 있는 메모리 추정치
| `Cached`          | 파일 캐시                        
| `SReclaimable`    | 회수 가능한 커널 slab 캐시         
| `SUnreclaim`      | 회수 어려운 커널 메모리             
| `Committed_AS`    | 프로세스들이 예약한 가상 메모리 총량 
| `CommitLimit`     | 시스템이 허용 가능한 커밋 한계      
| `HugePages_Total` | Oracle SGA용 HugePages 사용 가능성 
| `HugePages_Free`  | 예약됐지만 아직 사용 안 된 HugePages 


############################################################################################
# Memory Pressure
############################################################################################
vmstat 1 10

--------------------------------------------------------------------------------------------
si = swap in
so = swap out
| 상태            | 판단            
| --------------- | --------------- 
| `si/so`가 계속 0   | 메모리 압박 낮음     
| `si/so`가 간헐적 발생 | 메모리 압박 시작      
| `si/so`가 지속 발생  | DB 성능 저하 가능성 높음 


############################################################################################
# Used Memory per Prosess
############################################################################################
ps -eo pid,ppid,user,comm,rss,vsz,%mem --sort=-rss | head -30

--------------------------------------------------------------------------------------------
| 기준  | 설명                          
| --- | ----------------------------
| RSS | 해당 프로세스가 매핑한 메모리 크기         
| PSS | 공유 메모리를 프로세스 수로 나눈 실질 점유 추정치
| VSZ | 가상 주소 공간, 실제 물리 메모리 사용량 아님 

############################################################################################
# Memory per Process
############################################################################################
PID='value'
cat /proc/$PID/status | \
egrep 'Name|Pid|VmSize|VmRSS|RssAnon|RssFile|RssShmem|VmSwap|Threads' | \
awk '
/kB/ {
  printf "%-12s %10.1f MB\n", $1, $2/1024
  next
}
{
  print
}'

--------------------------------------------------------------------------------------------
| 항목         | 의미     
| ---------- | -------------------------- 
| `VmSize`   | 가상 메모리 전체   
| `VmRSS`    | 실제 물리 메모리에 올라간 크기 
| `RssAnon`  | 익명 메모리, 프로세스가 직접 쓰는 메모리 성격
| `RssFile`  | 파일 매핑 기반 메모리 
| `RssShmem` | 공유 메모리      
| `VmSwap`   | Swap으로 밀린 메모리   
| `Threads`  | 쓰레드 수                   

############################################################################################
# Memory OOM Case Check
############################################################################################
dmesg -T | egrep -i 'oom|out of memory|killed process|allocation|s1|sentinel'
egrep -i 'oom|out of memory|killed process|allocation|s1|sentinel' /var/log/messages
